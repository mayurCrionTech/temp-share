# MongoDB Connection Configuration
#
# IMPORTANT: This tool only ever reads data (it does not insert/update/delete
# anything). Point it at a MongoDB user that has ONLY the built-in "read"
# role on this database, not readWrite — e.g.:
#   db.createUser({ user: "dicv_exporter", pwd: "...", roles: [{ role: "read", db: "dicv_dt" }] })
# That way even a bug in this script (or in a future edit) physically cannot
# write to production PLC data.
MONGO_URI=mongodb://localhost:27017
DB_NAME=paintddt
TIMESERIES_COLLECTION=liveData_test
TAGS_COLLECTION=tag_lives

# Field names inside your documents — these vary by deployment.
# taghistories docs use `tagId`, liveData_test docs use `tag_id`, etc.
TAG_ID_FIELD=tag_id
TAG_NAME_FIELD=tagname

# When true (default), tag ObjectIds are re-resolved at startup by looking
# up each stage_config.js tagName in TAGS_COLLECTION (matching TAG_NAME_FIELD),
# instead of trusting the ids hardcoded in stage_config.js — which go stale
# whenever this tool points at a different DB/environment. Set to "false" to
# skip resolution and use the hardcoded ids as-is.
RESOLVE_TAG_IDS=true

# Driver read preference. Since this tool never writes, "secondaryPreferred"
# is safe and takes load off the primary. Use "primary" if you need the very
# latest data and have no secondaries.
READ_PREFERENCE=secondaryPreferred

# Target Cabin Numbers (comma-separated)
# CABINS=296860,296902,296854,296855,286858,296861,296876
CABINS=296227,296240

# Output File
OUTPUT_FILE=./output/cabin_stage_tracking.csv

# Optional Date Range (ISO format, leave empty for all data)
START_TIME=
END_TIME=

# Time tolerance window (ms) for pairing VIN_1 and VIN_2 tag readings
VIN_PAIR_TOLERANCE_MS=10000
